---
import Button from './Button.astro';
import CommandBlock from './CommandBlock.astro';
import Icon from './Icon.astro';
import { agent } from '../content/copy';
import { inline, twoTone } from '../lib/inline';
---

<section class="section" id="build-agent" aria-labelledby="agent-heading">
  <div class="container">
    <p class="eyebrow eyebrow--lg">{agent.eyebrow}</p>
    <h2 id="agent-heading" class="section-title" set:html={twoTone(agent.heading)} />
    <p class="section-intro agent-intro">{agent.intro}</p>

    <ol class="steps">
      {
        agent.steps.map((step, i) => {
          const n = String(i + 1).padStart(2, '0');
          return (
            <li class="step" data-reveal="children">
              <span class="step__num" aria-hidden="true">{n}</span>
              <div>
                <h3 class="card-title"><span class="visually-hidden">Step {i + 1}: </span>{step.title}</h3>
                <p class="card-text" set:html={inline(step.body)} />
              </div>
              {step.commands && (
                <CommandBlock
                  lang={step.commands.lang}
                  lines={step.commands.lines}
                  label={`Copy ${step.commands.lang === 'sql' ? 'SQL' : 'commands'} for step ${i + 1}`}
                  region={`${step.commands.lang === 'sql' ? 'SQL' : 'Shell commands'} for step ${i + 1}`}
                  cardLabel={agent.cardLabel[step.commands.lang]}
                />
              )}
              {step.visual?.kind === 'tool' && (
                <div class="step__art step__art--mono" aria-hidden="true">
                  <span class="step__file">{step.visual.file}</span><br />
                  <span class="step__kw">{step.visual.keyword}</span> <b>{step.visual.fn}</b>(<span class="step__param">{step.visual.param}</span>)
                </div>
              )}
              {step.visual?.kind === 'trace' && (
                <div class="step__art step__trace" aria-hidden="true" data-reveal-seq>
                  {step.visual.items.map((item, j) => (
                    <>
                      {j > 0 && <Icon name="arrow-right" size={16} class="step__arrow" />}
                      <span class="chip">{item}</span>
                    </>
                  ))}
                </div>
              )}
            </li>
          );
        })
      }
    </ol>

    <div class="agent-cta" data-reveal>
      <Button href={agent.cta.href} variant="secondary" icon="brand-github" cta="agents-repo">{agent.cta.label}</Button>
    </div>
    <p class="visually-hidden" aria-live="polite" id="copy-status"></p>
  </div>
</section>

<style>
  /* Wide enough for two balanced lines on desktop */
  .agent-intro {
    max-width: 50rem;
  }

  .steps {
    margin: var(--space-14) 0 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) minmax(0, 1.15fr);
    align-items: center;
    gap: var(--space-8);
    padding-block: var(--space-8);
    border-top: var(--border-width) solid var(--color-line);
  }

  .step:last-child {
    border-bottom: var(--border-width) solid var(--color-line);
  }

  .step__num {
    font-size: 3rem;
    font-weight: var(--weight-bold);
    line-height: 1;
    letter-spacing: var(--tracking-tighter);
    color: var(--color-numeral);
  }

  /* Type comes from .card-title (global.css); spacing only here */
  h3 {
    margin-bottom: var(--space-2);
  }

  /* Dark in both themes, on the terminal card's roles, to match the command cards */
  .step__art {
    padding: var(--space-4);
    background: var(--color-code-bg);
    border: var(--border-width) solid var(--color-code-line);
    border-radius: var(--radius-md);
    box-shadow: inset 0 1px 0 var(--color-code-edge);
    color: var(--color-code-text);
  }

  .step__art--mono {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.75;
  }

  .step__kw {
    color: var(--color-code-keyword);
  }

  .step__param {
    color: var(--color-code-flag);
  }

  .step__art--mono b {
    color: var(--color-code-cmd);
    font-weight: var(--weight-medium);
  }

  .step__file {
    color: var(--color-code-faint);
  }

  .step__trace {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }

  .chip {
    padding: var(--space-1) var(--space-3);
    border: var(--border-width) solid var(--color-code-hover-line);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    color: var(--color-code-text);
  }

  .step__trace :global(.step__arrow) {
    color: var(--color-code-faint);
  }

  /* A CTA follows its section header's alignment */
  .agent-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-10);
  }

  @media (max-width: 60rem) {
    .step {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      gap: var(--space-4) var(--space-5);
    }

    /* Picked by class: CommandBlock's <script> follows the first card, so :last-child would miss step 1 */
    .step > :global(.cmd),
    .step > .step__art {
      grid-column: 2;
    }
  }

  @media (max-width: 40rem) {
    .agent-cta {
      justify-content: flex-start;
    }

    .step {
      grid-template-columns: 2.75rem minmax(0, 1fr);
    }

    .step__num {
      font-size: 2.25rem;
    }

    .step > :global(.cmd),
    .step > .step__art {
      grid-column: 1 / -1;
    }
  }
</style>
