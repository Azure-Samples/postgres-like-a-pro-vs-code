---
/*
 * Hero video: the first clip on the extension's Marketplace listing
 * (microsoft/vscode-pgsql, img/intro-schema-agent-vid.gif), converted to MP4 + WebM and
 * self-hosted in public/media/, until the customer supplies a high-quality recording.
 * WCAG 2.2.2: it loops for more than 5 s, so it has a pause control.
 * Reduced motion: no autoplay; the poster shows and the button offers "Play".
 */
import Icon from './Icon.astro';
import { demo } from '../content/copy';
import { withBase } from '../lib/inline';
import { heroMedia } from '../lib/media';
---

<figure class="demo-wrap">
  <div class="demo-stage" aria-hidden="true"></div>
  <div class="demo-frame">
    <video
      class="demo-video"
      data-demo
      muted
      loop
      playsinline
      preload="metadata"
      width="1600"
      height="900"
      poster={withBase(heroMedia.poster)}
      aria-label={demo.label}
    >
      <source src={withBase(heroMedia.webm)} type="video/webm" />
      <source src={withBase(heroMedia.mp4)} type="video/mp4" />
    </video>
  </div>
  <figcaption class="demo-caption">
    <button class="demo-toggle is-paused" type="button" data-demo-toggle data-play={demo.play} data-pause={demo.pause}>
      <Icon name="player-pause" size={16} class="demo-toggle__pause" />
      <Icon name="player-play" size={16} class="demo-toggle__play" />
      <span data-demo-label>{demo.play}</span>
    </button>
  </figcaption>
</figure>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-demo]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-demo-toggle]');
  if (video && toggle) {
    const label = toggle.querySelector('[data-demo-label]');
    const sync = () => {
      const paused = video.paused;
      toggle.classList.toggle('is-paused', paused);
      if (label) label.textContent = (paused ? toggle.dataset.play : toggle.dataset.pause) ?? '';
    };
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    toggle.addEventListener('click', () => (video.paused ? video.play() : video.pause()));
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) video.play().catch(sync);
  }
</script>

<style>
  .demo-wrap {
    position: relative;
    margin: var(--space-16) auto 0;
    max-width: 61rem;
  }

  /* The video sits on lit ground: one soft pool beneath the frame.
     The product itself is never cropped or faded. */
  .demo-stage {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    left: 50%;
    bottom: 1.5rem;
    width: 78%;
    height: 7rem;
    transform: translateX(-50%);
    background: var(--glow-mint);
    opacity: calc(var(--glow-blue-opacity) * 1.3);
    filter: blur(var(--glow-blur-tight));
  }

  .demo-frame {
    position: relative;
    background: var(--color-raised);
    border: var(--border-width) solid var(--color-line-2);
    border-radius: var(--radius-xl);
    padding: var(--space-2);
    /* A brighter top edge in dark; a tinted drop beneath in both themes */
    box-shadow:
      var(--edge-highlight),
      0 18px 40px -30px var(--tint-30);
  }

  .demo-video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .demo-caption {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-faint);
  }

  .demo-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    border: var(--border-width) solid var(--color-line-2);
    background: none;
    color: var(--color-body);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      border-color var(--dur-state) var(--ease-state),
      color var(--dur-state) var(--ease-state),
      scale var(--dur-press) var(--ease-out);
  }

  .demo-toggle:is(:hover, :focus-visible) {
    border-color: var(--color-line-strong);
    color: var(--color-text);
  }

  /* Press feedback */
  @media (prefers-reduced-motion: no-preference) {
    .demo-toggle:active {
      scale: 0.97;
    }
  }

  /* Mouse devices: the control sits over the video's bottom-right corner, shown on
     hover, focus, or while paused (so there's always a way back to Play). Code-card colours,
     because the video is dark in both themes. Touch keeps it under the video, always visible. */
  @media (hover: hover) and (pointer: fine) {
    .demo-caption {
      position: absolute;
      right: calc(var(--space-2) + var(--space-3));
      bottom: calc(var(--space-2) + var(--space-3));
      margin: 0;
    }

    .demo-toggle {
      border-color: var(--color-code-line);
      background: color-mix(in srgb, var(--color-code-bg) 80%, transparent);
      color: var(--color-code-text);
      -webkit-backdrop-filter: blur(8px);
      backdrop-filter: blur(8px);
      opacity: 0;
      transition:
        opacity var(--dur-state) var(--ease-state),
        border-color var(--dur-state) var(--ease-state),
        scale var(--dur-press) var(--ease-out);
    }

    .demo-wrap:hover .demo-toggle,
    .demo-toggle:focus-visible,
    .demo-toggle.is-paused {
      opacity: 1;
    }

    .demo-toggle:is(:hover, :focus-visible) {
      border-color: var(--color-code-hover-line);
      color: var(--color-code-text);
    }

    .demo-toggle:focus-visible {
      outline-color: var(--color-code-focus);
    }
  }

  .demo-toggle :global(.demo-toggle__play),
  .demo-toggle.is-paused :global(.demo-toggle__pause) {
    display: none;
  }

  .demo-toggle.is-paused :global(.demo-toggle__play) {
    display: block;
  }
</style>
