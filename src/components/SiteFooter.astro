---
import Partners from './Partners.astro';
import { a11y, footer } from '../content/copy';

const legal = footer.legal.includes('{{') ? null : footer.legal;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <Partners size="footer" />
    <nav aria-label={footer.navLabel}>
      <ul class="site-footer__links">
        {
          footer.links.map((link, i) => (
            <li>
              {i > 0 && <span class="site-footer__dot" aria-hidden="true">·</span>}
              <a class="text-link" href={link.href} target="_blank" rel="noopener">
                {link.label}
                <span class="visually-hidden"> {a11y.newTab}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {legal && <p>{legal}</p>}
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-10);
    border-top: var(--border-width) solid var(--color-line);
    font-size: var(--text-sm);
    color: var(--color-faint);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__links li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Decorative: the list already separates the links for screen readers */
  .site-footer__dot {
    color: var(--color-faint);
  }

  /* Small-text grey: >= 4.8:1 on every surface */
  .site-footer__links .text-link {
    font-weight: var(--weight-regular);
    color: var(--color-faint);
  }

  .site-footer__links .text-link:is(:hover, :focus-visible) {
    color: var(--color-text);
  }
</style>
